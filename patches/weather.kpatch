# Weather: a rack that does not always play.
#
# A slow climate of four drifting RC-1 cells is the sky. Most of the time
# they sit under threshold and the amplifiers stay shut — you hear almost
# nothing. When one of them bursts, it current-drives an audible rain bank,
# walks a four-cell ring, and opens a pair of cross-coupled cells that
# oscillate in their chaotic window. A short envelope from the rain plucks
# a tone. Beside that, a granulating filter: four fast RC-1 clocks fire
# millisecond envelopes, neurons read different slices of the weather only
# while a grain is open, and a third memory (sand) slowly remaps those
# slices and the filter's ping. The grains are micro-changes — they do
# not fill the drought. Then adaptation pulls the sky back down and the
# room goes quiet again.
#
# The doors sidechain each other so a squall is not one swell. A grain
# cloud ducks the room; rain ducks the pair so it sings in the holes;
# the squall ducks the grains so they take the afterglow; each grit
# clock listens to a different weather slice and is inhibited by its
# neighbor flake. Later stages write back: sift readings echo into the
# sky cell that produced them, kick the rain or ring they read, and
# push the pair apart. A grain cloud also sidechains the grit clocks
# and teaches the memories, so the next burst is not the last one
# played backwards.
#
# A wide state-variable bandpass sits on the stereo mix at the end. The
# climate walks its centre; a grain cloud briefly peaks the Q. It is a
# large window, not another resonant ping, and a little of the dry mix
# stays so the climate body is still there.
#
# After that window, an eight-band fixed filter bank (ADDAC 601 centres)
# colours the mix. Sand tilts the bank; a grain cloud peaks its Q.
# A small room — short pre-delay into four combs and two allpasses —
# sits after the bank, before the compressor. It is a closet, not a hall.
#
# The microphone is limited, then split by a state-variable cell into
# low, mid and high. Those bands never reach the converter: their
# envelopes steer different parts of the climate. Low turns the sky,
# mid leans on the rain and the ring, high tickles the grit clocks.
# A tunable compressor sits on the stereo mix after the room.
# The live page desk pins the mic split, the output band, the filter
# bank, the room, the limiter and the compressor.
#
#   kaukonen play --patch patches/weather.kpatch --block 512 --gain 0.4
#   (256 is often fine; raise --block if `late` climbs)
#   then Capture on the page, or `input on` at the console.
#
#   kaukonen render --patch patches/weather.kpatch --seconds 12 \
#       --out out/weather.wav --html out/weather.html --stride 16
#
# Things worth turning first:
#
#   set sky.bias 2.4          # 1.8 is a long drought, 2.6 is almost always raining
#   set sky.rate 5            # how slowly the climate turns
#   set sky.drift 0.18        # wander that puts a cell in and out of bursting
#   set rain.bias 1.35        # the audible bank; keep it hungry so it needs the sky
#   set rain.rate 200
#   set fan.a0 0.16           # how hard a squall current-drives the rain
#   set hops.a0 0.14          # neighbour coupling on the ring
#   set a.bias 3.2            # the oscillating pair; near 3.2 they go chaotic
#   set room.cutoff 700
#   set roomamp.gain 0.04     # the quiet floor with no weather
#   set grit.rate 500         # how fine the grains are
#   set grit.bias 1.7         # 1.3 is a few sparks, 2.2 is a cloud
#   set flake.decay 0.02      # grain length; 0.006 is dust, 0.04 is pebbles
#   set dust.resonance 1.1    # the filter that sings on each grain
#   set sand.rule bcm         # how the grain memory walks
#   set roomcv.a1 -0.7        # grain-cloud duck on the room; 0 is lockstep
#   set paircv.a1 -0.5        # rain ducks the pair so it sings in the holes
#   set dustcv.a1 -0.45       # squall ducks the grains; they fill the afterglow
#   set poke.a1 0.16          # how much each grit clock hears its own slice
#   set cloud.decay 0.6       # how long the grain cloud holds the duck
#   set echo.a0 0.18          # how hard a grain reading writes back into the sky
#   set write.a0 0.14         # how hard that reading kicks the cell it read
#   set recoil.a1 -0.12       # grains push the pair apart
#   set lean.a0 0.1           # how much the grain sieve tilts the climate
#   set band.cutoff 600       # centre of the final window; 400 is dark, 1600 is thin
#   set band.q 0.45           # 0.4 is a large band, 2 is a wah
#   set bandcv.a0 0.28        # how far sand walks the band
#   set split.cutoff 700      # mic crossover; lower puts more speech into the sky
#   set miclim.threshold 1.6  # mic limiter; 1.2 is tight, 3 is almost off
#   set fbank.air 1.4         # 11 kHz band; 0 is dark, 2 is hiss
#   set fbank.mid 0.4         # scoop the 1.1 kHz band
#   set fbank.tilt 0.6        # + lifts the air, − lifts the sub
#   set verb.mix 0.3          # how much room; 0.5 is a cave
#   set verb.decay 0.55       # 0.2 is a slap, 0.8 rings
#   set outcomp.threshold 1.6 # output compressor
#   set outcomp.ratio 6       # 2 is gentle, 12 is a limiter
#   set outcomp.attack 0.004  # 0.001 is smash, 0.04 is level
#   set adc.gain 2.0          # how hard speech stirs the sky
#   gain 0.5

rate 48000
oversample 2
seconds 12
seed 23
mismatch 0.06
desk split.cutoff split.q band.cutoff band.q
desk miclim.threshold miclim.ratio
desk fbank.sub fbank.lowmid fbank.mid fbank.air fbank.tilt fbank.mix
desk verb.time verb.decay verb.mix
desk outcomp.threshold outcomp.ratio outcomp.attack outcomp.release

module adc      audioin   gain=1.5 env_rate=10
module miclim   comp      threshold=1.05 ratio=20 attack=0.0004 release=0.08 knee=0.15 makeup=1 mix=1
module split    svf       cutoff=850 q=0.52 drive=1.1 level=1.0
module micenv   env[3]    mode=follow attack=0.012 decay=0.16 level=5
module sky      rc1[4]    preset=burst rate=7 noise=0.035 drift=0.14 bias=2.05 output_gain=2.2
module rain     rc1[6]    preset=burst rate=170 noise=0.02 bias=1.45 output_gain=2
module ring     rc1[4]    preset=burst rate=64 noise=0.02 bias=1.7 output_gain=2
module hops     mix[4]    a0=0.11 a1=0.1 a2=0.04 a3=0.07
module a        rc1       preset=subthreshold leak=0 adaptation_rate=0.006 bias=3.18 rate=58 output_gain=2.2
module b        rc1       preset=subthreshold leak=0 adaptation_rate=0.006 bias=3.12 rate=66 output_gain=2.2
module grit     rc1[4]    preset=burst rate=420 noise=0.04 bias=1.42 output_gain=2.1
module flake    env[4]    mode=ad attack=0.0008 decay=0.014 threshold=1.45 level=5
module sift     neuron[4] w0=0.48 w1=0.85 w2=0.22 leak=12 gain=3.4 response=0.75
module sand     tc3       rule=oja gamma=0.45 scaling=0.55 target_norm=1.05 activity_gain=0.35
module poke     mix[4]    a0=1.0 a1=0.11 a2=0.07 a3=-0.08
module echo     mix[4]    a0=0.055 a1=0.07 a2=0.10 a3=0.04
module write    mix[4]    a0=0.05 a1=0.12 a2=0 a3=0 level=1.2
module recoil   mix       a0=0.08 a1=-0.055 a2=0.045 a3=0.04
module layer    neuron[3] w0=0.5 w1=0.3 w2=0.22 leak=10 gain=3.2 response=0.7
module hear     neuron    w0=0.4 w1=0.35 leak=12 gain=3 response=0.7
module see      neuron    w0=0.4 w1=0.3 leak=8 gain=3.2 response=0.7
module brain    tc3       rule=bcm theta_rate=2.5 natural_decay=0.25 scaling=2.2 target_norm=0.9 activity_gain=2 w_max=1.4 w_min=-1.4
module cortex   tc3       rule=oja gamma=0.5 scaling=0.8 target_norm=1.0 activity_gain=0.15
module gust     mix       a0=0.7 a1=0.65 a2=0.6 a3=0.55 level=0.9
module rainbox  mix       a0=0.7 a1=0.65 a2=0.6 a3=0 level=0.85
module rainbox2 mix       a0=0.7 a1=0.65 a2=0 a3=0 level=0.85
module shower   mix       a0=0.55 a1=0.5 level=0.8
module ringbox  mix       a0=0.7 a1=0.65 a2=0.6 a3=0.55 level=0.8
module bed      mix       a0=0.7 a1=0.4 level=0.85
module cross    mix       a0=0.32 a1=-0.32 a2=0 a3=0
module teach    mix       a0=0.3 a1=0.12 a2=0.1 a3=0
module sense    mix       a0=0.2 a1=0 a2=0 a3=0
module fan      mix       a0=0.14 a1=0.1 a2=0.03 a3=0.05
module tug      mix       a0=0.08 a1=0.1 a2=0.06 a3=0.04
module swell    mix       a0=0.5 a1=0.28 a2=0.35 a3=0 level=1.15
module open     mix       a0=2 a1=0.35 a2=-0.22 a3=0 level=3.5
module lift     mix       a0=0.8 a1=0.35 a2=0.25 a3=0.18 offset=0.9 level=0.65
module pace     mix       a0=0.4 a1=0.15 a2=0.18 a3=0.12
module stir     mix       a0=0.11 a1=0.08 a2=0.035 a3=-0.04 offset=0.03
module grain    mix       a0=0.7 a1=0.7 a2=0.7 a3=0.7 level=0.85
module sieve    mix       a0=0.55 a1=0.5 a2=0.45 a3=0.4 level=0.8
module tint     mix       a0=0.25 a1=0.16 a2=0.18 a3=0.12 offset=0.55 level=0.55
module roomcv   mix       a0=1.2 a1=-0.22 a2=-0.10 a3=0.14 level=1.0
module paircv   mix       a0=1.0 a1=-0.22 a2=0.2 a3=0.12 level=1.0
module dustcv   mix       a0=1.0 a1=-0.26 a2=0.12 a3=-0.14 level=1.0
module tonecv   mix       a0=1.0 a1=-0.42 a2=0.14 a3=-0.2 level=1.0
module lean     mix       a0=0.07 a1=0.05 a2=0.04 a3=0.035
module left     mix       a0=1.0 a1=0.45 a2=0.22 a3=0.28 level=0.9
module right    mix       a0=0.75 a1=0.7 a2=0.18 a3=0.34 level=0.9
module decay    source    shape=dc volts=0.14
module hiss     noise     level=0.7
module squall   env       mode=ad attack=0.02 decay=1.8 threshold=1.4 level=5
module tick     env       mode=ad attack=0.002 decay=0.16 threshold=1.5 level=5
module cloud    env       mode=ad attack=0.012 decay=0.22 threshold=1.55 level=5
module after    env       mode=ad attack=0.18 decay=0.75 threshold=2.2 level=5
module osc      vco       tune=92 fm_depth=28 pwm_depth=0.08 level=2.8
module room     vcf       cutoff=760 resonance=0.42 cv_depth=0.7 res_depth=0.06 drive=1.3
module air      vcf       cutoff=520 resonance=0.95 cv_depth=0.85 res_depth=0.1 drive=1.4
module dust     vcf       cutoff=1800 resonance=1.04 cv_depth=0.7 res_depth=0.1 drive=1.25
module roomamp  vca       response=exponential gain=0.03 cv_depth=1.05
module pairamp  vca       response=exponential gain=0.0 cv_depth=1.15
module toneamp  vca       response=exponential gain=0.0 cv_depth=1.0
module dustamp  vca       response=exponential gain=0.0 cv_depth=1.05
module band     svf[2]    cutoff=720 q=0.48 cv_depth=0.8 q_depth=0.08 drive=1.15 level=2.2
module bandcv   mix       a0=0.16 a1=0.12 a2=0.09 a3=-0.06
module end      mix[2]    a0=0.48 a1=0.72 level=0.95
module fbank    fbank[2]  sub=1.05 bass=1.1 low=0.95 lowmid=0.72 mid=0.68 highmid=0.88 high=1.18 air=1.28 q=2.0 tilt=0.12 tilt_depth=0.22 q_depth=0.08 mix=0.82 level=1.05
module verb     verb[2]   time=0.08 decay=0.35 damp=0.32 size=0.8 mix=0.20 time_depth=0.012 decay_depth=0.08 level=1.0
module outcomp  comp[2]   threshold=1.15 ratio=3.5 attack=0.004 release=0.18 knee=0.35 makeup=1.05 mix=1
module dac      audioout  rate=48000 level=0.30

knob flake[0].decay 0.008
knob flake[1].decay 0.012
knob flake[2].decay 0.02
knob flake[3].decay 0.03
knob grit[0].rate 380
knob grit[1].rate 450
knob grit[2].rate 530
knob grit[3].rate 620
knob grit[0].bias 1.38
knob grit[1].bias 1.46
knob grit[2].bias 1.34
knob grit[3].bias 1.50

# The sky is the climate. Its mix is the weather voltage.
patch sky[0].out -> gust.in0
patch sky[1].out -> gust.in1
patch sky[2].out -> gust.in2
patch sky[3].out -> gust.in3
patch sky[0].out -> squall.gate

# Rain is hungry. It only fires when the sky, speech, or the memory
# push current through the fan.
patch rain[0].out -> rainbox.in0
patch rain[1].out -> rainbox.in1
patch rain[2].out -> rainbox.in2
patch rain[3].out -> rainbox2.in0
patch rain[4].out -> rainbox2.in1
patch rain[5].out -> rainbox2.in2
patch rainbox.out  -> shower.in0
patch rainbox2.out -> shower.in1
patch gust.out     -> fan.in0
patch micenv[1].out -> fan.in1
patch brain.a      -> fan.in2
patch cloud.inv    -> fan.in3
patch fan.out      -> rain[*].in
patch rain[0].out  -> tick.gate

# A small ring walks when the weather is up. Speech leans on the hops
# the same way it does in duet — envelope, not waveform.
patch ring[0].out -> hops[1].in0
patch ring[1].out -> hops[2].in0
patch ring[2].out -> hops[3].in0
patch ring[3].out -> hops[0].in0
patch gust.out    -> hops[*].in1
patch micenv[1].out -> hops[*].in2
patch lean.out    -> hops[*].in3
patch hops[i].out -> ring[i].in
patch ring[0].out -> ringbox.in0
patch ring[1].out -> ringbox.in1
patch ring[2].out -> ringbox.in2
patch ring[3].out -> ringbox.in3
patch shower.out  -> bed.in0
patch ringbox.out -> bed.in1

# Two cells in the chaotic window, inverted into each other. They run
# all the time, but pairamp is shut until a squall.
patch a.out     -> cross.in0
patch b.out     -> cross.in1
patch cross.out -> b.in
patch cross.inv -> a.in
patch gust.out    -> tug.in0
patch micenv[1].out -> tug.in1
patch shower.out  -> tug.in2
patch sand.b      -> tug.in3
patch tug.out      -> a.in
patch tug.out      -> b.in
patch sift[2].out  -> recoil.in0
patch grain.out    -> recoil.in1
patch cortex.b     -> recoil.in2
patch layer[2].out -> recoil.in3
patch recoil.out   -> a.in
patch recoil.inv   -> b.in

# A tone that only exists for the length of a rain tick.
patch rain[2].out -> pace.in0
patch micenv[1].out -> pace.in1
patch after.out   -> pace.in2
patch sieve.out   -> pace.in3
patch pace.out    -> osc.fm
patch sand.c      -> osc.pwm
patch osc.tri     -> toneamp.in
patch tick.out    -> tonecv.in0
patch grain.out   -> tonecv.in1
patch sand.a      -> tonecv.in2
patch shower.out  -> tonecv.in3
patch tonecv.out  -> toneamp.cv

# Layer reads rain, ring, and the sky. Cortex watches the layer.
patch rain[0].out -> layer[0].in0
patch ring[0].out -> layer[1].in0
patch sky[0].out  -> layer[2].in0
patch rain[1].out -> layer[0].in1
patch rain[3].out -> layer[1].in1
patch rain[5].out -> layer[2].in1
patch micenv[1].out -> layer[*].in2
patch layer[0].out -> cortex.a
patch layer[1].out -> cortex.b
patch layer[2].out -> cortex.c
patch see.out      -> cortex.learn
patch cortex.activity -> cortex.learn
patch decay.out    -> cortex.forget

# BCM watches a compressed mic, the weather, and a read of the rain.
patch split.bp     -> hear.in0
patch micenv[1].out -> hear.in1
patch shower.out   -> see.in0
patch cortex.activity -> see.in1
patch hear.out     -> brain.a
patch micenv[1].out -> sense.in0
patch sense.out    -> brain.b
patch gust.out     -> brain.c
patch micenv[1].out -> teach.in0
patch brain.activity -> teach.in1
patch sieve.out    -> teach.in2
patch teach.out    -> brain.learn
patch decay.out    -> brain.forget
patch grain.out    -> cortex.learn

# Speech also current-drives the sky, so talking turns the climate over
# instead of sitting on the speakers. Grain readings write back into
# each sky cell; the sieve and the afterglow tilt two of them opposite
# ways so the climate does not repeat.
patch adc.env        -> sky[*].in
patch micenv[0].out  -> sky[*].in
patch adc.out        -> miclim.in
patch miclim.out     -> split.in
patch split.lp       -> micenv[0].gate
patch split.bp       -> micenv[1].gate
patch split.hp       -> micenv[2].gate
patch squall.out -> after.gate
patch sieve.out     -> lean.in0
patch layer[1].out  -> lean.in1
patch cloud.out     -> lean.in2
patch after.out     -> lean.in3
patch lean.out      -> sky[1].in
patch lean.inv      -> sky[3].in
patch flake[0].out  -> echo[0].in0
patch flake[1].out  -> echo[1].in0
patch flake[2].out  -> echo[2].in0
patch flake[3].out  -> echo[3].in0
patch layer[0].out  -> echo[0].in1
patch layer[1].out  -> echo[1].in1
patch layer[2].out  -> echo[2].in1
patch cortex.a      -> echo[3].in1
patch sift[0].out   -> echo[0].in2
patch sift[1].out   -> echo[1].in2
patch sift[2].out   -> echo[2].in2
patch sift[3].out   -> echo[3].in2
patch cloud.out     -> echo[0].in3
patch after.out     -> echo[1].in3
patch grain.out     -> echo[2].in3
patch cortex.activity -> echo[3].in3
patch echo[i].out   -> sky[i].in

# Timbre and doors. The amplifiers are exponential and almost closed.
# They no longer share one swell: a grain cloud ducks the room, rain
# ducks the pair, and nothing from adc.out reaches the bed.
patch gust.out         -> swell.in0
patch squall.out       -> swell.in1
patch adc.env          -> swell.in2
patch micenv[0].out    -> swell.in2
patch swell.out        -> roomcv.in0
patch cloud.out        -> roomcv.in1
patch shower.out       -> roomcv.in2
patch after.out        -> roomcv.in3
patch roomcv.out       -> roomamp.cv
patch swell.out        -> paircv.in0
patch shower.out       -> paircv.in1
patch after.out        -> paircv.in2
patch cortex.b         -> paircv.in3
patch paircv.out       -> pairamp.cv
patch brain.a          -> lift.in0
patch rain[1].out      -> lift.in1
patch micenv[0].out    -> lift.in2
patch sand.b           -> lift.in3
patch lift.out         -> room.cutoff_cv
patch cortex.a         -> air.cutoff_cv
patch after.out        -> air.cutoff_cv
patch brain.activity   -> room.res_cv
patch cloud.out        -> room.res_cv
patch hiss.pink        -> air.res_cv
patch gust.out         -> open.in0
patch after.out        -> open.in1
patch cloud.out        -> open.in2
patch open.out         -> air.cutoff_cv

# Grains. Fast mismatched clocks fire short envelopes. Each clock gets
# a different weather slice and is inhibited by a neighbor flake, so
# they do not fire in lockstep. The grain sieve also sidechains the
# clocks themselves. Neurons read a different slice of the weather
# while a flake is open; those readings echo into the sky and write
# back into the cell they came from. Sand slowly remaps the slices
# and the dust filter's corner. The squall ducks the grains so they
# take the afterglow. Nothing from adc.out reaches dust.
patch gust.out     -> stir.in0
patch micenv[2].out -> stir.in1
patch sand.a       -> stir.in2
patch sieve.out    -> stir.in3
patch stir.out     -> poke[*].in0
patch shower.out   -> poke[0].in1
patch ringbox.out  -> poke[1].in1
patch after.out    -> poke[2].in1
patch rain[4].out  -> poke[3].in1
patch sand.a       -> poke[0].in2
patch sand.b       -> poke[1].in2
patch sand.c       -> poke[2].in2
patch cortex.a     -> poke[3].in2
patch flake[3].out -> poke[0].in3
patch flake[0].out -> poke[1].in3
patch flake[1].out -> poke[2].in3
patch flake[2].out -> poke[3].in3
patch poke[i].out  -> grit[i].in
patch grit[i].out  -> flake[i].gate
patch grit[0].out  -> cloud.gate
patch flake[0].out -> grain.in0
patch flake[1].out -> grain.in1
patch flake[2].out -> grain.in2
patch flake[3].out -> grain.in3
patch bed.out      -> sift[0].in0
patch shower.out   -> sift[1].in0
patch a.out        -> sift[2].in0
patch ring[1].out  -> sift[3].in0
patch flake[i].out -> sift[i].in1
patch sand.a       -> sift[0].in2
patch sand.b       -> sift[1].in2
patch sand.c       -> sift[2].in2
patch sand.activity -> sift[3].in2
patch sift[0].out  -> sieve.in0
patch sift[1].out  -> sieve.in1
patch sift[2].out  -> sieve.in2
patch sift[3].out  -> sieve.in3
patch sift[0].out  -> sand.a
patch sift[1].out  -> sand.b
patch sift[2].out  -> sand.c
patch grain.out    -> sand.learn
patch decay.out    -> sand.forget
# A grain writes back into the cell it read: the flake is the pulse,
# the sift reading is the slower hang. Rain, the pair and the ring
# feel the granulator instead of only feeding it.
patch flake[i].out -> write[i].in0
patch sift[i].out  -> write[i].in1
patch write[0].out -> rain[0].in
patch write[1].out -> rain[2].in
patch write[2].out -> a.in
patch write[3].out -> ring[1].in
patch write[3].out -> hops[1].in3
patch sand.activity -> tint.in0
patch grain.out    -> tint.in1
patch sand.a       -> tint.in2
patch lean.out     -> tint.in3
patch tint.out     -> dust.cutoff_cv
patch sand.activity -> dust.res_cv
patch sieve.out    -> dust.in
patch dust.out     -> dustamp.in
patch grain.out    -> dustcv.in0
patch squall.out   -> dustcv.in1
patch sand.activity -> dustcv.in2
patch shower.out   -> dustcv.in3
patch dustcv.out   -> dustamp.cv

patch bed.out   -> room.in
patch room.out  -> roomamp.in
patch a.out     -> air.in
patch air.out   -> pairamp.in

patch roomamp.out -> left.in0
patch pairamp.out -> left.in1
patch toneamp.out -> left.in2
patch dustamp.out -> left.in3
patch roomamp.out -> right.in0
patch pairamp.out -> right.in1
patch toneamp.out -> right.in2
patch dustamp.out -> right.in3
patch left.out     -> band[0].in
patch right.out    -> band[1].in
patch sand.activity -> bandcv.in0
patch cloud.out     -> bandcv.in1
patch after.out     -> bandcv.in2
patch lean.out      -> bandcv.in3
patch bandcv.out    -> band[*].cutoff_cv
patch grain.out     -> band[*].q_cv
patch left.out     -> end[0].in0
patch band[0].bp   -> end[0].in1
patch right.out    -> end[1].in0
patch band[1].bp   -> end[1].in1
patch end[0].out   -> fbank[0].in
patch end[1].out   -> fbank[1].in
patch sand.activity -> fbank[*].tilt_cv
patch grain.out     -> fbank[*].res_cv
patch fbank[0].out -> verb[0].in
patch fbank[1].out -> verb[1].in
patch after.out    -> verb[*].time_cv
patch cloud.out    -> verb[*].decay_cv
patch verb[0].out  -> outcomp[0].in
patch verb[1].out  -> outcomp[1].in
patch outcomp[0].out -> dac.left
patch outcomp[1].out -> dac.right

