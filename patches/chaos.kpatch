# Two excitable cells in their chaotic window, cross-coupled.
#
# At a bias near 3.2 with slow adaptation, an RC-1 stops repeating itself: the
# bursts keep coming but never the same way twice. Each cell here also drives
# the other through an inverting mixer, and there is no stimulus at all - the
# activity is entirely the loop's own.
#
# Probe it to see the sensitivity directly. A tiny nudge to one bias grows
# into a different trajectory instead of dying away:
#
#   kaukonen probe --patch patches/chaos.kpatch --knob a.bias --seconds 40

dt 0.0005
seconds 40
seed 5

module a     rc1 preset=subthreshold leak=0 adaptation_rate=0.006 bias=3.2 rate=80
module b     rc1 preset=subthreshold leak=0 adaptation_rate=0.006 bias=3.15 rate=88
module cross mix a0=0.35 a1=-0.35 a2=0 a3=0

patch a.out     -> cross.in0
patch b.out     -> cross.in1
patch cross.out -> b.in
patch cross.inv -> a.in

record a.v a.r a.s b.v b.s cross.out
